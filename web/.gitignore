# See https://help.github.com/articles/ignoring-files/ for more about ignoring files.

# dependencies
/node_modules
/.pnp
.pnp.*
.yarn/*
!.yarn/patches
!.yarn/plugins
!.yarn/releases
!.yarn/versions

# testing
/coverage
/vitest-test-results

# next.js
/.next/
/out/

# production
/build

# misc
.DS_Store
*.pem
Thumbs.db

# debug
npm-debug.log*
yarn-debug.log*
yarn-error.log*
.pnpm-debug.log*

# local env files（含 Checkly 等凭据，禁止提交；只允许提交 .env.example）
.env*
!.env.example

# Sentry Config File
.env.sentry-build-plugin

# local folder
local

# local files
*.local.json
*.local.rules

# vercel
.vercel

# typescript
*.tsbuildinfo
next-env.d.ts

# Database
*.db

# storybook
storybook-static
*storybook.log
build-archive.log

# playwright
/test-results/
/playwright-report/
/playwright/.cache/

# 邮件/站内信模板的本机预览产物（server/tools/preview_mail_templates.py 生成）
/public/_preview/

# python 脚本缓存（scripts/make-brand-icons.py 等）
__pycache__/
*.pyc
